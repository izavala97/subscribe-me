@model suscribe_me.Controllers.FeedViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">
                @if (Model.Title == "Following")
                {
                    <i class="bi bi-people text-primary"></i>
                }
                else if (Model.Title == "Favorites")
                {
                    <i class="bi bi-heart text-danger"></i>
                }
                else
                {
                    <i class="bi bi-compass text-success"></i>
                }
                @Model.Title
            </h1>
            
            <div class="btn-group">
                <a asp-controller="Feed" asp-action="Explore" class="btn btn-outline-secondary @(Model.Title == "Explore" ? "active" : "")">
                    Explore
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Feed" asp-action="Following" class="btn btn-outline-secondary @(Model.Title == "Following" ? "active" : "")">
                        Following
                    </a>
                    <a asp-controller="Feed" asp-action="Favorites" class="btn btn-outline-secondary @(Model.Title == "Favorites" ? "active" : "")">
                        Favorites
                    </a>
                }
            </div>
        </div>
        
        @if (Model.Posts.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No posts yet</h5>
                    @if (Model.Title == "Following")
                    {
                        <p class="text-muted">Start following creators to see their posts here.</p>
                        <a asp-controller="Feed" asp-action="Explore" class="btn btn-primary">
                            <i class="bi bi-compass"></i> Explore Creators
                        </a>
                    }
                    else if (Model.Title == "Favorites")
                    {
                        <p class="text-muted">Posts you favorite will appear here.</p>
                        <a asp-controller="Feed" asp-action="Explore" class="btn btn-primary">
                            <i class="bi bi-compass"></i> Explore Posts
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">Be the first to create content!</p>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Post" asp-action="Create" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create Post
                            </a>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var postVm in Model.Posts)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <!-- Author info -->
                        <div class="d-flex align-items-center mb-3">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@postVm.Post.Author.Username" 
                               class="text-decoration-none">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" 
                                     style="width: 40px; height: 40px;">
                                    @postVm.Post.Author.Username.FirstOrDefault()
                                </div>
                            </a>
                            <div>
                                <a asp-controller="Profile" asp-action="Index" asp-route-username="@postVm.Post.Author.Username" 
                                   class="text-decoration-none fw-bold">
                                    @(postVm.Post.Author.DisplayName ?? postVm.Post.Author.Username)
                                </a>
                                <br>
                                <small class="text-muted">
                                    @@postVm.Post.Author.Username · @postVm.Post.CreatedAt.ToString("MMM d")
                                </small>
                            </div>
                        </div>
                        
                        <!-- Post title and content -->
                        <h5 class="card-title">
                            <a asp-controller="Post" asp-action="View" asp-route-id="@postVm.Post.Id" class="text-decoration-none">
                                @postVm.Post.Title
                            </a>
                        </h5>
                        
                        <div class="post-content text-muted">
                            @Html.Raw(postVm.ContentHtml)
                        </div>
                        
                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <div class="d-flex gap-3">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Favorite" asp-action="Toggle" asp-route-postId="@postVm.Post.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(postVm.IsFavorited ? "btn-danger" : "btn-outline-danger")">
                                            <i class="bi @(postVm.IsFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                                            @postVm.FavoriteCount
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="btn btn-sm btn-outline-danger disabled">
                                        <i class="bi bi-heart"></i> @postVm.FavoriteCount
                                    </span>
                                }
                            </div>
                            
                            <a asp-controller="Post" asp-action="View" asp-route-id="@postVm.Post.Id" class="btn btn-sm btn-outline-primary">
                                Read more <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
            
            <!-- Pagination -->
            <div class="d-flex justify-content-between mt-4">
                @if (Model.CurrentPage > 1)
                {
                    <a href="?page=@(Model.CurrentPage - 1)" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Previous
                    </a>
                }
                else
                {
                    <span></span>
                }
                
                @if (Model.HasMore)
                {
                    <a href="?page=@(Model.CurrentPage + 1)" class="btn btn-outline-secondary">
                        Next <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>
