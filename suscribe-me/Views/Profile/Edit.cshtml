@model suscribe_me.Controllers.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Edit Profile</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label">Display Name</label>
                        <input asp-for="DisplayName" class="form-control" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label">Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="5" placeholder="Tell your followers about yourself..."></textarea>
                        <div class="form-text">Supports Markdown formatting.</div>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="MonthlyPriceCents" class="form-label">Monthly Subscription Price</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" 
                                   value="@((Model.MonthlyPriceCents / 100.0).ToString("F2"))" 
                                   step="0.01" min="0" max="1000"
                                   id="priceInput" />
                            <input type="hidden" asp-for="MonthlyPriceCents" id="priceCents" />
                        </div>
                        <div class="form-text">
                            Set to $0 for no paid subscription tier. 
                            Subscribers will get access to your "Subscribers Only" posts.
                        </div>
                        <span asp-validation-for="MonthlyPriceCents" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@User.Identity?.Name" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Convert dollars to cents before form submission
        document.getElementById('priceInput').addEventListener('input', function() {
            const cents = Math.round(parseFloat(this.value || 0) * 100);
            document.getElementById('priceCents').value = cents;
        });
        
        // Initialize on page load
        const cents = parseInt(document.getElementById('priceCents').value || 0);
        document.getElementById('priceInput').value = (cents / 100).toFixed(2);
    </script>
}
