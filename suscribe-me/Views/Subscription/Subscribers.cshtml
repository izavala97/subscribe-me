@model List<suscribe_me.Models.Subscription>
@{
    ViewData["Title"] = "My Subscribers";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="h3 mb-4">
            <i class="bi bi-people-fill text-primary"></i> My Subscribers
        </h1>
        
        @if (Model.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No subscribers yet</h5>
                    <p class="text-muted">Set up a subscription price in your profile to start earning.</p>
                    <a asp-controller="Profile" asp-action="Edit" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <strong>@Model.Count</strong> active subscriber(s) · 
                Earning <strong>$@((Model.Sum(s => s.AmountCents) / 100.0).ToString("F2"))</strong>/month
            </div>
            
            <div class="list-group shadow-sm">
                @foreach (var subscription in Model)
                {
                    <div class="list-group-item d-flex align-items-center p-3">
                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@subscription.Subscriber.Username" 
                           class="text-decoration-none">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" 
                                 style="width: 50px; height: 50px;">
                                @subscription.Subscriber.Username.FirstOrDefault()
                            </div>
                        </a>
                        <div class="flex-grow-1">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@subscription.Subscriber.Username" 
                               class="text-decoration-none fw-bold">
                                @(subscription.Subscriber.DisplayName ?? subscription.Subscriber.Username)
                            </a>
                            <br>
                            <small class="text-muted">
                                Subscribed since @subscription.StartedAt.ToString("MMM d, yyyy")
                            </small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success">$@((subscription.AmountCents / 100.0).ToString("F2"))/mo</span>
                            <br>
                            <a asp-controller="Chat" asp-action="New" asp-route-userId="@subscription.SubscriberId" 
                               class="btn btn-sm btn-outline-primary mt-1">
                                <i class="bi bi-chat"></i> Message
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
