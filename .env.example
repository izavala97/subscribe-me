# Subscribe-Me Environment Variables
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
# Development (SQLite - no config needed, uses appsettings.Development.json)
# Production options:
# ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Database=suscribe-me;User ID=your-user;Password=your-password;Encrypt=True;
# PostgreSQL alternative:
# ConnectionStrings__DefaultConnection=Host=your-server.postgres.database.azure.com;Database=suscribe-me;Username=your-user;Password=your-password;SSL Mode=Require;

# ═══════════════════════════════════════════════════════════════
# AZURE COMMUNICATION SERVICES (Email)
# ═══════════════════════════════════════════════════════════════
# Get from: Azure Portal → Communication Services → Keys
Azure__CommunicationServices__ConnectionString=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key
Azure__CommunicationServices__SenderAddress=donotreply@your-domain.azurecomm.net

# ═══════════════════════════════════════════════════════════════
# AZURE BLOB STORAGE (Media files)
# ═══════════════════════════════════════════════════════════════
# Get from: Azure Portal → Storage Account → Access keys
Azure__BlobStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=your-account-key;EndpointSuffix=core.windows.net
Azure__BlobStorage__ContainerName=media

# ═══════════════════════════════════════════════════════════════
# AZURE SIGNALR SERVICE (Real-time chat)
# ═══════════════════════════════════════════════════════════════
# Get from: Azure Portal → SignalR Service → Keys
# Leave empty for local SignalR (development)
Azure__SignalR__ConnectionString=Endpoint=https://your-signalr.service.signalr.net;AccessKey=your-access-key;Version=1.0;

# ═══════════════════════════════════════════════════════════════
# STRIPE (Payments)
# ═══════════════════════════════════════════════════════════════
# Get from: https://dashboard.stripe.com/test/apikeys (test mode)
# Get from: https://dashboard.stripe.com/apikeys (live mode)
Stripe__PublishableKey=pk_test_your_publishable_key
Stripe__SecretKey=sk_test_your_secret_key
# Get from: Stripe CLI or Dashboard → Webhooks → Signing secret
Stripe__WebhookSecret=whsec_your_webhook_secret

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
App__BaseUrl=https://localhost:5001
# Production example:
# App__BaseUrl=https://your-app.azurewebsites.net

# ═══════════════════════════════════════════════════════════════
# NOTES
# ═══════════════════════════════════════════════════════════════
# - In development, most Azure services use mock implementations
# - The mock email service logs magic links to the console
# - The mock payment service simulates successful payments
# - SQLite is used automatically in development mode
# - For local Stripe webhook testing, run:
#   stripe listen --forward-to https://localhost:5001/api/webhooks/stripe
