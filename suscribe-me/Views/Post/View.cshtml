@model suscribe_me.Controllers.PostViewViewModel
@{
    ViewData["Title"] = Model.Post.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <article class="card shadow-sm">
            <div class="card-body p-4">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h1 class="h3 mb-2">@Model.Post.Title</h1>
                        <div class="d-flex align-items-center text-muted">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@Model.Post.Author.Username" 
                               class="text-decoration-none me-3">
                                <i class="bi bi-person-circle"></i> @(Model.Post.Author.DisplayName ?? Model.Post.Author.Username)
                            </a>
                            <span><i class="bi bi-clock"></i> @Model.Post.CreatedAt.ToString("MMMM d, yyyy")</span>
                            @if (Model.Post.UpdatedAt.HasValue)
                            {
                                <span class="ms-2">(edited)</span>
                            }
                        </div>
                    </div>
                    <span class="badge @GetVisibilityBadgeClass(Model.Post.Visibility)">
                        @GetVisibilityLabel(Model.Post.Visibility)
                    </span>
                </div>
                
                <hr />
                
                <!-- Content -->
                @if (Model.CanAccess)
                {
                    <div class="post-content">
                        @Html.Raw(Model.ContentHtml)
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary">
                        <h5><i class="bi bi-lock"></i> This content is locked</h5>
                        
                        @if (!string.IsNullOrEmpty(Model.Post.PreviewText))
                        {
                            <p>@Model.Post.PreviewText</p>
                        }
                        
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (Model.Post.Visibility == suscribe_me.Models.PostVisibility.FollowersOnly)
                            {
                                <p>Follow @Model.Post.Author.Username to unlock this content.</p>
                                <form asp-controller="Follow" asp-action="Toggle" asp-route-userId="@Model.Post.AuthorId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-person-plus"></i> Follow
                                    </button>
                                </form>
                            }
                            else if (Model.Post.Visibility == suscribe_me.Models.PostVisibility.SubscribersOnly)
                            {
                                <p>Subscribe to @Model.Post.Author.Username to unlock this and all their subscriber content.</p>
                                <form asp-controller="Subscription" asp-action="Subscribe" asp-route-creatorId="@Model.Post.AuthorId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-star"></i> Subscribe
                                    </button>
                                </form>
                            }
                            else if (Model.Post.Visibility == suscribe_me.Models.PostVisibility.SinglePurchase)
                            {
                                <p>Purchase this post for one-time access.</p>
                                <form asp-controller="Subscription" asp-action="PurchasePost" asp-route-postId="@Model.Post.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning">
                                        <i class="bi bi-unlock"></i> Unlock for $@((Model.Post.PriceCents / 100.0).ToString("F2"))
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <p>Please sign in to access this content.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Sign In
                            </a>
                        }
                    </div>
                }
                
                <hr />
                
                <!-- Actions -->
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Favorite" asp-action="Toggle" asp-route-postId="@Model.Post.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(Model.IsFavorited ? "btn-danger" : "btn-outline-danger")">
                                    <i class="bi @(Model.IsFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                                    @Model.FavoriteCount
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="btn btn-outline-danger disabled">
                                <i class="bi bi-heart"></i> @Model.FavoriteCount
                            </span>
                        }
                    </div>
                    
                    @if (Model.IsOwner)
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Post.Id" class="btn btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Post.Id" method="post" 
                                  onsubmit="return confirm('Are you sure you want to delete this post?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </article>
        
        <div class="mt-3">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

@functions {
    string GetVisibilityBadgeClass(suscribe_me.Models.PostVisibility visibility) => visibility switch
    {
        suscribe_me.Models.PostVisibility.Public => "bg-success",
        suscribe_me.Models.PostVisibility.FollowersOnly => "bg-info",
        suscribe_me.Models.PostVisibility.SubscribersOnly => "bg-warning text-dark",
        suscribe_me.Models.PostVisibility.SinglePurchase => "bg-danger",
        _ => "bg-secondary"
    };
    
    string GetVisibilityLabel(suscribe_me.Models.PostVisibility visibility) => visibility switch
    {
        suscribe_me.Models.PostVisibility.Public => "Public",
        suscribe_me.Models.PostVisibility.FollowersOnly => "Followers Only",
        suscribe_me.Models.PostVisibility.SubscribersOnly => "Subscribers Only",
        suscribe_me.Models.PostVisibility.SinglePurchase => "Paid",
        _ => "Unknown"
    };
}
