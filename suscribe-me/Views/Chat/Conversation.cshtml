@model suscribe_me.Controllers.ChatConversationViewModel
@{
    ViewData["Title"] = $"Chat with {Model.CurrentConversation.DisplayName ?? Model.CurrentConversation.Username}";
}

<div class="row" style="height: calc(100vh - 200px);">
    <!-- Conversation List (sidebar) -->
    <div class="col-md-4 col-lg-3 border-end d-none d-md-block" style="overflow-y: auto; height: 100%;">
        <h6 class="p-3 border-bottom mb-0">
            <i class="bi bi-chat-dots"></i> Conversations
        </h6>
        <div class="list-group list-group-flush">
            @foreach (var conversation in Model.Conversations)
            {
                var isActive = conversation.OtherUser.Id == Model.CurrentConversation.Id;
                <a asp-controller="Chat" asp-action="Conversation" asp-route-userId="@conversation.OtherUser.Id" 
                   class="list-group-item list-group-item-action d-flex align-items-center py-2 @(isActive ? "active" : "")">
                    <div class="rounded-circle @(isActive ? "bg-white text-primary" : "bg-primary text-white") d-flex align-items-center justify-content-center me-2" 
                         style="width: 35px; height: 35px; font-size: 0.9rem;">
                        @conversation.OtherUser.Username.FirstOrDefault()
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <div class="fw-bold text-truncate">@(conversation.OtherUser.DisplayName ?? conversation.OtherUser.Username)</div>
                        <small class="text-truncate d-block @(isActive ? "text-white-50" : "text-muted")">
                            @(conversation.LastMessage.Content.Length > 30 ? conversation.LastMessage.Content[..30] + "..." : conversation.LastMessage.Content)
                        </small>
                    </div>
                    @if (conversation.UnreadCount > 0 && !isActive)
                    {
                        <span class="badge bg-danger rounded-pill">@conversation.UnreadCount</span>
                    }
                </a>
            }
        </div>
    </div>
    
    <!-- Chat Area -->
    <div class="col-md-8 col-lg-9 d-flex flex-column" style="height: 100%;">
        <!-- Chat Header -->
        <div class="border-bottom p-3 d-flex align-items-center">
            <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-outline-secondary me-3 d-md-none">
                <i class="bi bi-arrow-left"></i>
            </a>
            <a asp-controller="Profile" asp-action="Index" asp-route-username="@Model.CurrentConversation.Username" 
               class="text-decoration-none d-flex align-items-center">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" 
                     style="width: 40px; height: 40px;">
                    @Model.CurrentConversation.Username.FirstOrDefault()
                </div>
                <div>
                    <div class="fw-bold">@(Model.CurrentConversation.DisplayName ?? Model.CurrentConversation.Username)</div>
                    <small class="text-muted">@@Model.CurrentConversation.Username</small>
                </div>
            </a>
        </div>
        
        <!-- Messages -->
        <div class="flex-grow-1 p-3" style="overflow-y: auto;" id="messagesContainer">
            @if (Model.Messages.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-chat-dots" style="font-size: 3rem;"></i>
                    <p class="mt-3">No messages yet. Say hello!</p>
                </div>
            }
            else
            {
                @foreach (var message in Model.Messages)
                {
                    var isMine = message.SenderId == Model.CurrentUserId;
                    <div class="d-flex mb-2 @(isMine ? "justify-content-end" : "justify-content-start")">
                        <div class="p-2 rounded-3 @(isMine ? "bg-primary text-white" : "bg-light")" 
                             style="max-width: 70%;">
                            <div>@message.Content</div>
                            <small class="@(isMine ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">
                                @message.SentAt.ToString("h:mm tt")
                                @if (isMine && message.IsRead)
                                {
                                    <i class="bi bi-check2-all ms-1"></i>
                                }
                            </small>
                        </div>
                    </div>
                }
            }
        </div>
        
        <!-- Message Input -->
        <div class="border-top p-3">
            <form asp-controller="Chat" asp-action="Send" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="receiverId" value="@Model.CurrentConversation.Id" />
                <input type="text" name="content" class="form-control" placeholder="Type a message..." 
                       autocomplete="off" autofocus required maxlength="4000" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to bottom of messages
        const container = document.getElementById('messagesContainer');
        container.scrollTop = container.scrollHeight;
    </script>
}
