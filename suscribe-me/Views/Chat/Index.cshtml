@model suscribe_me.Controllers.ChatIndexViewModel
@{
    ViewData["Title"] = "Messages";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="h3 mb-4">
            <i class="bi bi-chat-dots text-primary"></i> Messages
        </h1>
        
        @if (Model.Conversations.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-chat-dots text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No conversations yet</h5>
                    <p class="text-muted">Start a conversation by visiting a creator's profile and clicking "Message".</p>
                    <a asp-controller="Feed" asp-action="Explore" class="btn btn-primary">
                        <i class="bi bi-compass"></i> Explore Creators
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var conversation in Model.Conversations)
                {
                    <a asp-controller="Chat" asp-action="Conversation" asp-route-userId="@conversation.OtherUser.Id" 
                       class="list-group-item list-group-item-action d-flex align-items-center p-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" 
                             style="width: 50px; height: 50px;">
                            @conversation.OtherUser.Username.FirstOrDefault()
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">@(conversation.OtherUser.DisplayName ?? conversation.OtherUser.Username)</h6>
                                <small class="text-muted">@conversation.LastMessage.SentAt.ToString("MMM d")</small>
                            </div>
                            <p class="mb-0 text-muted text-truncate" style="max-width: 400px;">
                                @conversation.LastMessage.Content
                            </p>
                        </div>
                        @if (conversation.UnreadCount > 0)
                        {
                            <span class="badge bg-primary rounded-pill ms-2">@conversation.UnreadCount</span>
                        }
                    </a>
                }
            </div>
        }
    </div>
</div>
