@model suscribe_me.Controllers.ProfileViewModel
@{
    ViewData["Title"] = Model.User.DisplayName ?? Model.User.Username;
}

<div class="row">
    <!-- Profile Header -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" 
                             style="width: 100px; height: 100px; font-size: 2.5rem;">
                            @(Model.User.DisplayName?.FirstOrDefault() ?? Model.User.Username.FirstOrDefault())
                        </div>
                    </div>
                    <div class="col">
                        <h1 class="h3 mb-1">@(Model.User.DisplayName ?? Model.User.Username)</h1>
                        <p class="text-muted mb-2">
                            <i class="bi bi-at"></i>@Model.User.Username
                        </p>
                        <div class="d-flex gap-3 mb-2">
                            <span><strong>@Model.FollowerCount</strong> followers</span>
                            <span><strong>@Model.FollowingCount</strong> following</span>
                            <span><strong>@Model.SubscriberCount</strong> subscribers</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.BioHtml))
                        {
                            <div class="mt-3">
                                @Html.Raw(Model.BioHtml)
                            </div>
                        }
                    </div>
                    <div class="col-auto">
                        @if (Model.IsOwner)
                        {
                            <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit Profile
                            </a>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="d-flex flex-column gap-2">
                                <!-- Follow/Unfollow Button -->
                                <form asp-controller="Follow" asp-action="Toggle" asp-route-userId="@Model.User.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    @if (Model.IsFollowing)
                                    {
                                        <button type="submit" class="btn btn-outline-secondary w-100">
                                            <i class="bi bi-person-check"></i> Following
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-person-plus"></i> Follow
                                        </button>
                                    }
                                </form>
                                
                                <!-- Subscribe Button -->
                                @if (Model.User.MonthlyPriceCents > 0)
                                {
                                    @if (Model.IsSubscribed)
                                    {
                                        <span class="btn btn-success disabled w-100">
                                            <i class="bi bi-star-fill"></i> Subscribed
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-controller="Subscription" asp-action="Subscribe" asp-route-creatorId="@Model.User.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning w-100">
                                                <i class="bi bi-star"></i> Subscribe $@((Model.User.MonthlyPriceCents / 100.0).ToString("F2"))/mo
                                            </button>
                                        </form>
                                    }
                                }
                                
                                <!-- Message Button -->
                                <a asp-controller="Chat" asp-action="New" asp-route-userId="@Model.User.Id" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-chat"></i> Message
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Posts -->
    <div class="col-12">
        @if (Model.IsOwner)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Your Posts</h2>
                <a asp-controller="Post" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Post
                </a>
            </div>
        }
        else
        {
            <h2 class="h5 mb-3">Posts</h2>
        }
        
        @if (Model.Posts.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-file-text text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-3">No posts yet.</p>
                    @if (Model.IsOwner)
                    {
                        <a asp-controller="Post" asp-action="Create" class="btn btn-primary">
                            Create your first post
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            @foreach (var postVm in Model.Posts)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <a asp-controller="Post" asp-action="View" asp-route-id="@postVm.Post.Id" class="text-decoration-none">
                                    @postVm.Post.Title
                                </a>
                            </h5>
                            <span class="badge @GetVisibilityBadgeClass(postVm.Post.Visibility)">
                                @GetVisibilityLabel(postVm.Post.Visibility)
                            </span>
                        </div>
                        
                        <p class="text-muted small mb-2">
                            <i class="bi bi-clock"></i> @postVm.Post.CreatedAt.ToString("MMM d, yyyy")
                            @if (postVm.Post.Visibility == suscribe_me.Models.PostVisibility.SinglePurchase)
                            {
                                <span class="ms-2"><i class="bi bi-tag"></i> $@((postVm.Post.PriceCents / 100.0).ToString("F2"))</span>
                            }
                        </p>
                        
                        @if (postVm.CanAccess)
                        {
                            <div class="post-content">
                                @Html.Raw(postVm.ContentHtml.Length > 300 ? postVm.ContentHtml[..300] + "..." : postVm.ContentHtml)
                            </div>
                            <a asp-controller="Post" asp-action="View" asp-route-id="@postVm.Post.Id" class="btn btn-sm btn-outline-primary mt-2">
                                Read more
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-0">
                                <i class="bi bi-lock"></i>
                                @if (!string.IsNullOrEmpty(postVm.Post.PreviewText))
                                {
                                    <span>@postVm.Post.PreviewText</span>
                                }
                                else
                                {
                                    <span>This content is for @GetVisibilityLabel(postVm.Post.Visibility).ToLower() only.</span>
                                }
                                
                                @if (postVm.Post.Visibility == suscribe_me.Models.PostVisibility.SinglePurchase)
                                {
                                    <form asp-controller="Subscription" asp-action="PurchasePost" asp-route-postId="@postVm.Post.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-warning ms-2">
                                            Unlock for $@((postVm.Post.PriceCents / 100.0).ToString("F2"))
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@functions {
    string GetVisibilityBadgeClass(suscribe_me.Models.PostVisibility visibility) => visibility switch
    {
        suscribe_me.Models.PostVisibility.Public => "bg-success",
        suscribe_me.Models.PostVisibility.FollowersOnly => "bg-info",
        suscribe_me.Models.PostVisibility.SubscribersOnly => "bg-warning text-dark",
        suscribe_me.Models.PostVisibility.SinglePurchase => "bg-danger",
        _ => "bg-secondary"
    };
    
    string GetVisibilityLabel(suscribe_me.Models.PostVisibility visibility) => visibility switch
    {
        suscribe_me.Models.PostVisibility.Public => "Public",
        suscribe_me.Models.PostVisibility.FollowersOnly => "Followers",
        suscribe_me.Models.PostVisibility.SubscribersOnly => "Subscribers",
        suscribe_me.Models.PostVisibility.SinglePurchase => "Paid",
        _ => "Unknown"
    };
}
