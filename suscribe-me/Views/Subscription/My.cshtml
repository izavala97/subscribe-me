@model List<suscribe_me.Models.Subscription>
@{
    ViewData["Title"] = "My Subscriptions";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <h1 class="h3 mb-4">
            <i class="bi bi-credit-card text-primary"></i> My Subscriptions
        </h1>
        
        @if (Model.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-star text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">No subscriptions yet</h5>
                    <p class="text-muted">Subscribe to creators to access their exclusive content.</p>
                    <a asp-controller="Feed" asp-action="Explore" class="btn btn-primary">
                        <i class="bi bi-compass"></i> Explore Creators
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var subscription in Model)
                {
                    <div class="col-md-6 mb-3">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <a asp-controller="Profile" asp-action="Index" asp-route-username="@subscription.Creator.Username" 
                                       class="text-decoration-none">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" 
                                             style="width: 50px; height: 50px;">
                                            @subscription.Creator.Username.FirstOrDefault()
                                        </div>
                                    </a>
                                    <div>
                                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@subscription.Creator.Username" 
                                           class="text-decoration-none fw-bold">
                                            @(subscription.Creator.DisplayName ?? subscription.Creator.Username)
                                        </a>
                                        <br>
                                        <small class="text-muted">@@subscription.Creator.Username</small>
                                    </div>
                                </div>
                                
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @GetStatusBadgeClass(subscription.Status)">
                                        @subscription.Status
                                    </span>
                                    <span class="text-muted">
                                        $@((subscription.AmountCents / 100.0).ToString("F2"))/month
                                    </span>
                                </div>
                                
                                <p class="text-muted small mb-0">
                                    Started: @subscription.StartedAt.ToString("MMM d, yyyy")
                                    @if (subscription.CurrentPeriodEnd.HasValue)
                                    {
                                        <br>
                                        @if (subscription.Status == suscribe_me.Models.SubscriptionStatus.Active)
                                        {
                                            <span>Renews: @subscription.CurrentPeriodEnd.Value.ToString("MMM d, yyyy")</span>
                                        }
                                        else
                                        {
                                            <span>Ends: @subscription.CurrentPeriodEnd.Value.ToString("MMM d, yyyy")</span>
                                        }
                                    }
                                </p>
                            </div>
                            <div class="card-footer bg-transparent">
                                @if (subscription.Status == suscribe_me.Models.SubscriptionStatus.Active)
                                {
                                    <form asp-controller="Subscription" asp-action="Cancel" asp-route-subscriptionId="@subscription.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to cancel this subscription?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Cancel Subscription
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        @if (subscription.CancelledAt.HasValue)
                                        {
                                            <text>Cancelled on @subscription.CancelledAt.Value.ToString("MMM d, yyyy")</text>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusBadgeClass(suscribe_me.Models.SubscriptionStatus status) => status switch
    {
        suscribe_me.Models.SubscriptionStatus.Active => "bg-success",
        suscribe_me.Models.SubscriptionStatus.PastDue => "bg-warning text-dark",
        suscribe_me.Models.SubscriptionStatus.Cancelled => "bg-secondary",
        suscribe_me.Models.SubscriptionStatus.Expired => "bg-danger",
        _ => "bg-secondary"
    };
}
