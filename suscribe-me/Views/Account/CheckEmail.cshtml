@model suscribe_me.Controllers.CheckEmailViewModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                </div>
                
                <h2 class="card-title mb-3">Check Your Email</h2>
                
                <p class="text-muted mb-4">
                    We've sent a magic link to<br>
                    <strong class="text-dark">@Model.Email</strong>
                </p>
                
                <div class="alert alert-info text-start">
                    <h6 class="alert-heading"><i class="bi bi-info-circle"></i> What's next?</h6>
                    <ol class="mb-0 ps-3">
                        <li>Open your email inbox</li>
                        <li>Find the email from Subscribe-Me</li>
                        <li>Click the magic link to @(Model.IsRegistration ? "complete your registration" : "sign in")</li>
                    </ol>
                </div>
                
                <p class="text-muted small mt-4">
                    <i class="bi bi-clock"></i> The link expires in 15 minutes.<br>
                    Don't see the email? Check your spam folder.
                </p>
                
                <hr class="my-4" />
                
                <a asp-action="@(Model.IsRegistration ? "Register" : "Login")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Try a different email
                </a>
            </div>
        </div>
    </div>
</div>
